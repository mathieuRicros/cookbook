# Copier en .env pour le développement local
PORT=4000

# Origine autorisée pour le CORS (URL du front)
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL (celle du conteneur Docker "db")
DATABASE_URL=postgresql://cookbook:cookbook@localhost:5432/cookbook

# Connexion Google : identifiant client OAuth (console Google Cloud)
GOOGLE_CLIENT_ID=

# Clé de signature des sessions. En production : une longue valeur aléatoire
# (générer avec : openssl rand -base64 32)
JWT_SECRET=dev-secret-a-ne-pas-utiliser-en-production
